DATABASE_URL=postgresql+psycopg://document_processing_app:change_me@postgres.example.internal:5432/document_processing
ENVIRONMENT=production
LOG_LEVEL=INFO
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
PORT=8000
FORWARDED_ALLOW_IPS=127.0.0.1
EASYOCR_MODEL_STORAGE_DIRECTORY=/opt/easyocr/model
EASYOCR_USER_NETWORK_DIRECTORY=/opt/easyocr/user_network
EASYOCR_DOWNLOAD_ENABLED=false
MAX_UPLOAD_SIZE_BYTES=20971520
MAX_FILENAME_LENGTH=255
MAX_PDF_PAGES=50
MAX_IMAGE_WIDTH=20000
MAX_IMAGE_HEIGHT=20000
MAX_IMAGE_PIXELS=100000000
ALLOWED_HOSTS=api.example.com
CORS_ALLOWED_ORIGINS=
EXPOSE_API_DOCS=false
OIDC_ENABLED=false
OIDC_ISSUER=https://login.microsoftonline.com/your-tenant-id/v2.0
OIDC_AUDIENCE=your-api-application-client-id
OIDC_JWKS_URL=https://login.microsoftonline.com/your-tenant-id/discovery/v2.0/keys
OIDC_ALGORITHMS=RS256
OIDC_TENANT_CLAIM=tid
OIDC_SUBJECT_CLAIM=sub
OIDC_SCOPES_CLAIM=scp
RATE_LIMIT_ENABLED=false
RATE_LIMIT_STORAGE_URI=redis://redis.example.internal:6379/0
RATE_LIMIT_EXTRACT_PER_MINUTE=10
RATE_LIMIT_API_KEYS_PER_MINUTE=30
RATE_LIMIT_READ_PER_MINUTE=120
