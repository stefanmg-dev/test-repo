{
  "invoice": {
    "default_profile": "telecom_a1",
    "common_fields": [
      {
        "name": "supplier_name",
        "type": "llm",
        "validation": []
      },
      {
        "name": "supplier_id",
        "type": "regex_list",
        "occurrence": "first",
        "rules": [
          "ЕИК[:\\s]*([0-9]{9,13})",
          "ДДС[:\\s]*BG([0-9]{9,13})"
        ],
        "validation": [
          {
            "type": "required",
            "message": "Supplier ID is required"
          },
          {
            "type": "regex",
            "pattern": "[0-9]{9,13}",
            "message": "Supplier ID must contain between 9 and 13 digits"
          }
        ]
      },
      {
        "name": "invoice_number",
        "type": "regex_list",
        "occurrence": "first",
        "rules": [
          "Фактура\\s*№\\s*([0-9]{8,15})",
          "към\\s+фактура\\s*№\\s*([0-9]{8,15})",
          "Фактура\\s*N[gоo°]?\\s*([0-9]{8,15})",
          "Фактура\\s+([0-9]{8,15})"
        ],
        "validation": [
          {
            "type": "required",
            "message": "Invoice number is required"
          },
          {
            "type": "regex",
            "pattern": "[0-9]{8,15}",
            "message": "Invoice number must contain between 8 and 15 digits"
          }
        ]
      },
      {
        "name": "issue_date",
        "type": "regex_list",
        "occurrence": "first",
        "rules": [
          "Дата на издаване[:\\s\\n]*([0-9]{2}\\.[0-9]{2}\\.[0-9]{4})",
          "([0-9]{2}\\.[0-9]{2}\\.[0-9]{4})[\\s\\n]*Дата на издаване"
        ],
        "validation": [
          {
            "type": "required",
            "message": "Issue date is required"
          },
          {
            "type": "date",
            "format": "%d.%m.%Y",
            "message": "Issue date must be a valid date in DD.MM.YYYY format"
          }
        ]
      },
      {
        "name": "customer_name",
        "type": "regex_list",
        "occurrence": "first",
        "rules": [
          "Име:\\s*Адрес:\\s*([А-Я][а-я]+\\s+[А-Я][а-я]+\\s+[А-Я][а-я]+)",
          "Име:\\s*([А-Я][а-я]+\\s+[А-Я][а-я]+\\s+[А-Я][а-я]+)",
          "^\\s*(?:от\\s+4\\s*)?\\n?\\s*1\\s*\\n\\s*([А-Я][а-я]+\\s+[А-Я][а-я]+\\s+[А-Я][а-я]+)"
        ],
        "validation": [
          {
            "type": "required",
            "message": "Customer name is required"
          }
        ]
      },
      {
        "name": "customer_address",
        "type": "regex_list",
        "occurrence": "first",
        "rules": [
          "((?:ж\\.?\\s*к\\.?)\\s*[^\\n]*?ап\\.?\\s*[0-9]+)",
          "(жк\\.[^\\n]+)",
          "Адрес:\\s*((?:ж\\.?\\s*к\\.?)?\\s*[^\\n]*?ап\\.?\\s*[0-9]+)"
        ],
        "validation": [
          {
            "type": "required",
            "message": "Customer address is required"
          }
        ]
      },
      {
        "name": "due_date",
        "type": "regex",
        "rule": "Краен срок на плащане[:\\s\\n]*([0-9]{2}\\.[0-9]{2}\\.[0-9]{4})",
        "occurrence": "last",
        "validation": [
          {
            "type": "required",
            "message": "Due date is required"
          },
          {
            "type": "date",
            "format": "%d.%m.%Y",
            "message": "Due date must be a valid date in DD.MM.YYYY format"
          }
        ]
      },
      {
        "name": "total_amount",
        "type": "regex",
        "rule": "Обща стойност за плащане\\s*([0-9]+[.,][0-9]+)",
        "occurrence": "last",
        "validation": [
          {
            "type": "required",
            "message": "Total amount is required"
          },
          {
            "type": "decimal",
            "minimum": "0.01",
            "message": "Total amount must be a positive decimal number"
          }
        ]
      }
    ],
