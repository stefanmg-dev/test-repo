DATABASE_URL=postgresql+psycopg://document_processing_app:change_me@localhost:5432/document_processing
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
MAX_UPLOAD_SIZE_BYTES=20971520
MAX_FILENAME_LENGTH=255
MAX_PDF_PAGES=50
MAX_IMAGE_WIDTH=20000
MAX_IMAGE_HEIGHT=20000
MAX_IMAGE_PIXELS=100000000
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CORS_ALLOWED_ORIGINS=
EXPOSE_API_DOCS=true
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ALGORITHMS=RS256
OIDC_TENANT_CLAIM=tid
OIDC_SUBJECT_CLAIM=sub
OIDC_SCOPES_CLAIM=scp
RATE_LIMIT_ENABLED=false
RATE_LIMIT_STORAGE_URI=memory://
RATE_LIMIT_EXTRACT_PER_MINUTE=10
RATE_LIMIT_API_KEYS_PER_MINUTE=30
RATE_LIMIT_READ_PER_MINUTE=120
