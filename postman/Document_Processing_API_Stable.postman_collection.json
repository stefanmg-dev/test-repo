                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json(); pm.test(\"Retention execution contract is present\", function () { pm.expect(body).to.include.keys(\"retention_days\", \"cutoff\", \"limit\", \"deleted_count\"); });",
                  "pm.test(\"Execution respects requested bound\", function () { pm.expect(body.deleted_count).to.be.at.most(Number(pm.environment.get(\"retention_limit\") || 100)); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-API-Key",
