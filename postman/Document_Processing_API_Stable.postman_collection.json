    {
      "name": "01 Extract Document",
      "item": [
        {
          "name": "A1 Invoice",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{base_url}}/extract-document",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "document_type",
                  "value": "invoice",
                  "type": "text"
                },
                {
                  "key": "file",
                  "type": "file",
                  "src": "{{a1_invoice_path}}"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"X-Request-ID is present\", function () { pm.expect(pm.response.headers.get(\"X-Request-ID\")).to.be.a(\"string\").and.not.empty; });",
                  "pm.test(\"Response is JSON\", function () { pm.expect(pm.response.headers.get(\"Content-Type\") || \"\").to.include(\"application/json\"); });",
                  "const body = pm.response.json();",
                  "pm.test(\"Extraction response has stable top-level contract\", function () { pm.expect(body).to.include.keys(\"document_type\", \"processing_status\", \"quality\", \"final_values\", \"validation\"); });",
                  "pm.collectionVariables.set(\"latest_processing_status\", body.processing_status || \"\");",
                  "pm.collectionVariables.set(\"latest_profile\", body.profile || \"\");",
                  "pm.sendRequest({url: pm.variables.replaceIn(\"{{base_url}}/api/v1/processing-runs?offset=0&limit=1\"), method: \"GET\", header: {\"Accept\": \"application/json\"}}, function (error, response) { if (!error && response.code === 200) { const payload = response.json(); if (payload.items && payload.items.length) { pm.collectionVariables.set(\"latest_processing_run_id\", payload.items[0].id); } } });",
                  "const expectedProfile = pm.environment.get(\"a1_expected_profile\");",
                  "pm.test(\"Expected profile is selected\", function () { pm.expect(body.profile).to.eql(expectedProfile); });"
                ]
              }
            }
          ]
        },
